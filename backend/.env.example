PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/warehouse_mgmt_db
JWT_SECRET=change_this_secret
JWT_EXPIRE=1d
REFRESH_TOKEN_SECRET=change_this_secret_too
REFRESH_TOKEN_EXPIRE=7d
CLIENT_URL=http://localhost:5173

# Optional: low-stock email alerts. Leave unset to disable — the app runs fine without them.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
